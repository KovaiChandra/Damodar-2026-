{
  "permissions": {
    "allow": [
      "Bash(node server.js)",
      "Bash(npm run *)",
      "Bash(npm start)",
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)"
